# Copia este archivo y renómbralo a ".env" (sin .example)
# Luego completa cada valor con los tuyos.

SECRET_KEY=cambia-esto-por-cualquier-texto-largo-y-random
DEBUG=True

# Datos de la cuenta de Gmail que ENVIARÁ los avisos de voto
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion-de-16-caracteres

# Correo donde quieres RECIBIR el aviso de cada voto (puede ser el mismo de arriba)
CORREO_ORGANIZADOR=correo-donde-recibiras-los-avisos@gmail.com

# --- Personalización de la votación (opcional) ---
# Si no defines estas variables, se usan los valores por defecto de settings.py.

# Título que encabeza la pantalla de resultados y el Excel
VOTACION_TITULO=Elección de Directorio 2026-2028

# Texto que acompaña a los electos cuando se cierra la votación
VOTACION_SUBTITULO_ELECTOS=Directorio electo

# Logo de la esquina: ruta dentro de static/. Déjalo vacío para no mostrar ninguno.
ORGANIZACION_LOGO=logo.svg

# Nombre que acompaña al logo (texto alternativo, accesibilidad)
ORGANIZACION_NOMBRE=ProyectsZH
